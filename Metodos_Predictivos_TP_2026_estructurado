        "#instalación de librería sklearn. Ofrece múltiples herramientas de machine learning y modelado estadístico.\n",
        "%pip install scikit-learn\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler #importación para estandarización de variables.\n",
        "#Nótese que ahora sí es necesario estandarizar primero, pues LOF no considera escalas.\n",
        "from sklearn.neighbors import LocalOutlierFactor #importación para LOF.\n",
        "\n",
        "#Préstese atención a que también se están estandarizando variables de polaridad y sentimiento debido a que pueden variar en una escala que incluye números negativos.\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(df[cols_cuantitativas]) #Estandarización.\n",
        "\n",
        "# n_neighbors: cantidad de vecinos que se utiliza para definir el entorno local\n",
        "# contamination: proporción esperada de observaciones atípicas, se modifica esta vez con el fin de aumentar la exigencia considerada al momento de discriminar qué observaciones se considerarán outliers.\n",
        "lof = LocalOutlierFactor(n_neighbors=5000, contamination=0.01) # Se ajusta el modelo, considerando 5000 vecinos e incrementando la exigencia aplicando una proporción esperada de observaciones atípicas de un 1%.\n",
        "pred_lof = lof.fit_predict(X_scaled)\n",
        "\n",
        "# sklearn entrega el score con signo negativo: se modifica de tal forma que un valor mayor represente una mayor anomalía\n",
        "df['lof'] = -lof.negative_outlier_factor_\n",
        "df['atipico_lof'] = pred_lof == -1\n",
        "\n",
        "df[['id'] + cols_cuantitativas + ['lof', 'atipico_lof']] \\\n",
        "    .sort_values('lof', ascending=False).head(10)"
      ]
    },
