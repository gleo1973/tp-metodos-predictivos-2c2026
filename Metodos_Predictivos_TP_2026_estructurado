      "source": [
        "def calcular_bins(df, columna, tamaño_intervalo):\n",
        "    valor_maximo = df[columna].max()\n",
        "    # Convertimos a int porque NumPy devuelve un float (ej: 800.0) y 'bins' requiere un entero\n",
        "    return int(np.ceil(valor_maximo / tamaño_intervalo))\n",
        "print(f\"la cantidad bins para la columna shares con  intervalos de 3000 es {calcular_bins(df,\"shares\",3000)}\")"
      ]
